view: topic_recommendations {
  sql_table_name: `@{GCP_PROJECT}.@{DATASET}.topic_recommendations` ;;
  label: "Recommendations"

  dimension: topic_id {
    primary_key: yes
    hidden: yes
    sql: ${TABLE}.topic_id ;;
  }

  dimension: problem_statement {
    description: "Standardised failure-demand problem statement generated by Gemini from aggregated topic statistics."
    sql: ${TABLE}.problem_statement ;;
  }

  dimension: recommended_action {
    description: "AI-suggested improvement. A starting point for the owning team, not a decision."
    sql: ${TABLE}.recommended_action ;;
  }

  dimension: suggested_owner {
    sql: ${TABLE}.suggested_owner ;;
  }

  dimension: expected_impact {
    sql: ${TABLE}.expected_impact ;;
  }

  dimension: model_version {
    hidden: yes
    sql: ${TABLE}.model_version ;;
  }
}
